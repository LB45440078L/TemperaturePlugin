<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>top.cmarco</groupId>
  <artifactId>temperature-plugin-parent</artifactId>
  <version>3.0.0</version>
  <packaging>pom</packaging>

  <name>TemperaturePlugin (parent)</name>
  <description>
    A physics-based, environment-driven temperature simulation for Spigot Minecraft servers
    (and Paper, which provides the same API).
    The build is split into a platform-free simulation core and a Spigot adapter, so the entire
    heat-transfer model is unit-testable without a running server.
  </description>

  <modules>
    <module>temperature-core</module>
    <module>temperature-plugin</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Spigot 26.2 requires Java 25. `release` (not source/target) also restricts the compile
         classpath to that API level, so a newer-only API fails here instead of at runtime. -->
    <maven.compiler.release>25</maven.compiler.release>

    <spigot.api.version>26.2-R0.1-SNAPSHOT</spigot.api.version>
    <placeholderapi.version>2.12.3</placeholderapi.version>
    <annotations.version>24.1.0</annotations.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <mockito.version>5.24.0</mockito.version>

    <compiler.plugin.version>3.16.0</compiler.plugin.version>
    <surefire.plugin.version>3.6.0</surefire.plugin.version>
    <shade.plugin.version>3.6.2</shade.plugin.version>
    <asm.version>9.10.1</asm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- JUnit 5/6 platform, imported as a BOM so the individual Jupiter artifacts need no
           version of their own. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-core</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- The server supplies the API. `provided` keeps it off the runtime classpath and out of the
           shaded jar, which is what makes the shipped artifact small.

           SPIGOT, NOT PAPER. The API is the common denominator: everything below is written
           against org.bukkit and the bundled net.md_5.bungee chat classes, both of which Spigot
           and Paper provide. Nothing may reference net.kyori.adventure or any other Paper-only
           type - Paper bundles Adventure inside its own jar and Spigot does not, so a plugin
           compiled against Paper's API dies on a Spigot server with
           NoClassDefFoundError: net/kyori/adventure/text/Component. -->
      <dependency>
        <groupId>org.spigotmc</groupId>
        <artifactId>spigot-api</artifactId>
        <version>${spigot.api.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- spigot-api does not carry the JetBrains annotations transitively, so they are declared
           explicitly rather than relying on whatever Paper happened to pull in. -->
      <dependency>
        <groupId>org.jetbrains</groupId>
        <artifactId>annotations</artifactId>
        <version>${annotations.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- PlaceholderAPI is a soft dependency: the server provides it only when installed, so it
           is `provided` and the expansion is registered defensively at runtime. -->
      <dependency>
        <groupId>me.clip</groupId>
        <artifactId>placeholderapi</artifactId>
        <version>${placeholderapi.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>top.cmarco</groupId>
        <artifactId>temperature-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <!-- Spigot's own snapshot repository: spigot-api is published here and nowhere else. -->
    <repository>
      <id>spigot-repo</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
    <repository>
      <id>placeholderapi</id>
      <url>https://repo.extendedclip.com/releases/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.plugin.version}</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
