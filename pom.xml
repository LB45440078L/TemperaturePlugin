<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>top.cmarco</groupId>
  <artifactId>temperature-plugin-parent</artifactId>
  <version>3.0.0</version>
  <packaging>pom</packaging>

  <name>TemperaturePlugin (parent)</name>
  <description>
    A physics-based, environment-driven temperature simulation for Paper Minecraft servers.
    The build is split into a platform-free simulation core and a Paper adapter, so the entire
    heat-transfer model is unit-testable without a running server.
  </description>

  <modules>
    <module>temperature-core</module>
    <module>temperature-plugin</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Paper 26.2 requires Java 25. `release` (not source/target) also restricts the compile
         classpath to that API level, so a newer-only API fails here instead of at runtime. -->
    <maven.compiler.release>25</maven.compiler.release>

    <paper.api.version>26.2.build.129-stable</paper.api.version>
    <placeholderapi.version>2.12.3</placeholderapi.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <mockito.version>5.24.0</mockito.version>

    <compiler.plugin.version>3.16.0</compiler.plugin.version>
    <surefire.plugin.version>3.6.0</surefire.plugin.version>
    <shade.plugin.version>3.6.2</shade.plugin.version>
    <asm.version>9.10.1</asm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- JUnit 5/6 platform, imported as a BOM so the individual Jupiter artifacts need no
           version of their own. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-core</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- The server supplies the Paper API. `provided` keeps it off the runtime classpath and
           out of the shaded jar, which is what makes the shipped artifact small. -->
      <dependency>
        <groupId>io.papermc.paper</groupId>
        <artifactId>paper-api</artifactId>
        <version>${paper.api.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- PlaceholderAPI is a soft dependency: the server provides it only when installed, so it
           is `provided` and the expansion is registered defensively at runtime. -->
      <dependency>
        <groupId>me.clip</groupId>
        <artifactId>placeholderapi</artifactId>
        <version>${placeholderapi.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>top.cmarco</groupId>
        <artifactId>temperature-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <repository>
      <id>placeholderapi</id>
      <url>https://repo.extendedclip.com/releases/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.plugin.version}</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
